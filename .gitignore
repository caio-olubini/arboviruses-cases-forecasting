# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tests / cache
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Local / large data (keep .gitkeep; track small samples if needed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.parquet

# Figures / outputs
docs/figures/*
!docs/figures/.gitkeep
